    {
      "id": "book-azure",
      "stageId": "stage-azure",
      "name": "青玄界",
      "summary": "山河还在问道。话本、真名，和一卷不许翻开的青册。",
      "entries": [
        {
          "id": "entry-azure-air",
          "title": "氛围",
          "body": "青玄界的天光像没干的墨。城镇檐角挂着问道的幡，风一过，幡上的字就换一种读法。村庄夜里听得见溪水把人名往下游送。皇宫深处有一卷青册，封面凉，不许翻开。人与人之间先问一句「可说」，再说下一句。",
          "keywords": [
            "青玄",
            "问道",
            "青册",
            "氛围"
          ],
          "enabled": true
        },
        {
          "id": "entry-azure-conflict",
          "title": "冲突",
          "body": "暖璃想把散落的典故收成一本能核对的书。月曈偏要把没写完的传说当场讲活，讲到听的人忍不住接话。清言守着那条线：有些话说出口就会成真，不能为了热闹说第二遍。皇宫要封山清修，村庄还靠山路换盐。封与不封，青册都不许被拿来当令箭。",
          "keywords": [
            "封山",
            "传说",
            "冲突",
            "青册"
          ],
          "enabled": true
        },
        {
          "id": "entry-azure-taboo",
          "title": "禁忌",
          "body": "不许对月立空誓。不许在皇宫里把同一个人的真名连叫三次。问道可以，逼人把道说死不行。不要把仙门规矩写成给自己钻的漏洞。青册可以提起，不可以打开。",
          "keywords": [
            "禁忌",
            "真名",
            "空誓",
            "青册"
          ],
          "enabled": true
        }
      ],
      "patches": [
        {
          "id": "patch-azure-ink",
          "title": "未干的墨",
          "body": "城镇西市有人卖没写完的话本。买的人要自己决定结局。这是同一本书的补丁。",
          "enabled": true,
          "createdAt": "2026-10-10T00:00:00.000Z"
        }
      ],
