  "worldBooks": [
    {
      "id": "book-frost",
      "stageId": "stage-frost",
      "name": "霜印王国",
      "summary": "长冬未尽的北境。炉火、誓言，和还没结清的霜税。",
      "entries": [
        {
          "id": "entry-frost-air",
          "title": "氛围",
          "body": "霜印王国停在长冬里。城镇的石路白天也结着薄霜，店铺把炉火对着门；村庄的烟压得很低，屋顶的雪要人自己铲。王宫大门的铜环冷得粘手，门内的地毯却是干的。人说话留一半在喉咙里，另一半交给炉火。夜里同一处只是把窗子关上，火还在，路更白。",
          "keywords": [
            "霜",
            "炉火",
            "长冬",
            "氛围"
          ],
          "enabled": true
        },
        {
          "id": "entry-frost-conflict",
          "title": "冲突",
          "body": "王室要南境今年的粮，村庄说去年的霜税还没结清，不能再交。Astrid 站在王宫大门和村路之间，盾是职务，耳朵却是自己的。Sigrid 记得每一笔旧账，也记得那首不许在税官面前唱完的歌。Elin 把数字摊在城镇的桌上，谁都别想把「大约」写进账里。有人说旧王的印还在某条冰河里，谁去捞，谁就得先决定站在哪一边。",
          "keywords": [
            "霜税",
            "粮",
            "冲突",
            "冰河"
          ],
          "enabled": true
        },
        {
          "id": "entry-frost-taboo",
          "title": "禁忌",
          "body": "不许在炉火前撒谎，谎会跟着烟留下来。不许直呼亡者的冬名。王宫内部未经传召不得拔剑，门前拔剑也一样被看成闯宫。不要把「霜印」当成可以临时改口的契约。",
          "keywords": [
            "禁忌",
            "炉火",
            "冬名",
            "拔剑"
          ],
          "enabled": true
        }
      ],
      "patches": [
        {
          "id": "patch-frost-salt",
          "title": "北境的盐",
          "body": "村庄换盐的小路这一季结冰更早。这是后补的细节，不是另一本世界书。",
          "enabled": true,
          "createdAt": "2026-10-10T00:00:00.000Z"
        }
      ],
